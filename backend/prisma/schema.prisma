generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL "pooled" (Neon: se termine par -pooler dans le hostname) - utilisée
  // à l'exécution par les fonctions serverless, avec ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // URL directe (sans pooler) - utilisée uniquement par `prisma migrate deploy`.
  directUrl = env("DIRECT_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  authKeyHash      String
  saltBase64       String
  vaultData        String?
  vaultIv          String?
  failedAttempts   Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions         Session[]
  auditLogs        AuditLog[]
}

// Une session = un appareil connecté
// Remplace le refreshTokenHash unique sur User
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  lookupToken      String    @unique  // 16 bytes hex - recherche O(1) par index
  refreshTokenHash String             // bcrypt(secretToken) - vérification
  // lookupToken d'avant la dernière rotation : le revoir passé un court
  // délai de grâce signale un refresh token volé et rejoué (session révoquée).
  previousLookupToken String?  @unique
  rotatedAt        DateTime?
  userAgent        String?   // "Chrome 124 / macOS"
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  expiresAt        DateTime  // TTL explicite - nettoyage facile

  @@index([userId])
}

// Toutes les actions sensibles sont tracées ici
model AuditLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?     // infos supplémentaires selon l'action
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REGISTER
  VAULT_READ
  VAULT_WRITE
  SESSION_REVOKED
  ACCOUNT_DELETED
  ACCOUNT_DELETE_FAILED
  PASSWORD_CHANGE_ATTEMPT
}
